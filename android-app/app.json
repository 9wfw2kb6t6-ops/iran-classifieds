{
  "expo": {
    "name": "سه‌سوته",
    "slug": "sesote",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sesote",
    "extra": {
      "eas": {
        "projectId": "e3e80dad-d298-4191-b5fd-2e038822092a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "برای انتخاب عکس و ثبت آگهی در سه‌سوته به دسترسی عکس‌ها نیاز داریم."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "ir.sesote.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EF"
      }
    },
    "ios": {
      "bundleIdentifier": "ir.sesote.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "برای انتخاب عکس و ثبت آگهی در سه‌سوته به دسترسی عکس‌ها نیاز داریم."
      }
    }
  }
}
